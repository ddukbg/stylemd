<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Document</title>
  <style>
    :root {
      --bg: #0b0c0f;
      --fg: #f2f3f5;
      --muted: #a6adbb;
      --line: rgba(255,255,255,0.12);
      --accent: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      line-height: 1.65;
    }
    a { color: var(--fg); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
    a:hover { opacity: 0.85; }

    .wrap {
      max-width: 860px;
      margin: 0 auto;
      padding: 26px 16px 64px;
    }

    header {
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
      margin-bottom: 18px;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: baseline;
      justify-content: space-between;
    }

    .site {
      font-weight: 700;
      letter-spacing: 0.6px;
    }

    nav a { margin-right: 12px; }

    .muted { color: var(--muted); font-size: 13px; }

    h1 { font-size: 28px; margin: 0.4em 0 0.7em; }
    h2 { font-size: 20px; margin-top: 1.8em; }

    pre {
      overflow: auto;
      padding: 14px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.03);
    }

    blockquote {
      margin: 18px 0;
      padding: 8px 14px;
      border-left: 4px solid var(--line);
      color: var(--muted);
    }

    @media (max-width: 640px) {
      h1 { font-size: 24px; }
      .wrap { padding-top: 16px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="meta">
        <div>
          <div class="site">MONO MINIMAL</div>
          <div class="muted">Typography-first, no distractions</div>
        </div>
        <nav>
          <a href="index.html">Home</a>
        </nav>
      </div>
    </header>

    {{{content}}}
  </div>
</body>
</html>
